{
  "name": "winnow-root",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.18.2",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "prepare": "lefthook install",
    "dev": "node scripts/dev.ts",
    "verify": "bash scripts/verify.sh",
    "verify:backend": "bash scripts/verify.sh backend",
    "verify:frontend": "bash scripts/verify.sh frontend",
    "verify:e2e": "bash scripts/verify.sh e2e",
    "exercise": "node scripts/exercise.ts",
    "gen:api": "bash scripts/gen-api.sh",
    "format": "pnpm --filter winnow-frontend format && prettier --write scripts e2e playwright.config.ts && uv run --project backend ruff format backend"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "lefthook": "^2.2.2",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3"
  }
}
